rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && myRole() == 'Admin'; }
    function isProduction() { return isSignedIn() && myRole() == 'Production'; }
    function isInstallation() { return isSignedIn() && myRole() == 'Installation'; }
    function isSales() { return isSignedIn() && myRole() == 'Sales'; }

    function orderStatusOk(s) {
      return s == 'Pause Shipment' || s == 'Please Ship' || s == 'Cancelled';
    }
    function orderPaymentOk(s) {
      return s == 'Paid' || s == 'Advance' || s == 'COD' || s == 'Cancelled';
    }
    // True when `field` was not part of this write, or its new value is allowed.
    function statusChangeOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        || orderStatusOk(request.resource.data.status);
    }
    function paymentChangeOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['payment'])
        || orderPaymentOk(request.resource.data.payment);
    }

    // Each signed-in user has one doc here holding their role. On first
    // login the app creates its own placeholder doc (role: null); an admin
    // then sets the real role from the Manage Users page. Users can't set
    // their own role — only an admin can update/delete these docs.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    // Customer orders, keyed by group number (see groupNumberToId in the app:
    // "/" in a group number is stored as "~" in the document id).
    // Sales creates and edits order details only — not the machine link.
    // Production assigns or clears the machine. Installation may refresh the
    // denormalized fulfillmentStatus when delivery / installation is saved.
    // Admin can do all of that. The one-time sheet import uses the Admin SDK
    // and is not limited by these rules.
    match /orders/{orderId} {
      allow read: if isSignedIn();

      allow create: if (isAdmin() || isSales())
        && request.resource.data.groupNumber is string
        && request.resource.data.groupNumber.size() > 0
        && request.resource.data.groupNumber.size() < 80
        && orderId == request.resource.data.groupNumber.replace('/', '~')
        && orderStatusOk(request.resource.data.status)
        && orderPaymentOk(request.resource.data.payment)
        && request.resource.data.customer is string
        && request.resource.data.machineId == ''
        && request.resource.data.machineNumber == '';

      allow update: if request.resource.data.groupNumber == resource.data.groupNumber
        && (
          isAdmin()
          || (isSales()
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['machineId', 'machineNumber', 'fulfillmentStatus'])
              && statusChangeOk()
              && paymentChangeOk())
          || (isProduction()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['machineId', 'machineNumber', 'fulfillmentStatus', 'updatedAt', 'updatedBy']))
          || (isInstallation()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['fulfillmentStatus', 'updatedAt', 'updatedBy']))
        );

      allow delete: if isAdmin();
    }

    match /machines/{machineId} {
      allow read: if isSignedIn();
      // Sales is intentionally absent: that role edits orders, not machines.
      allow create: if isAdmin() || isProduction();
      // Installation can update delivery / installation, not return history.
      allow update: if isAdmin() || isProduction()
        || (isInstallation()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['intake', 'cycles', 'cycle']));
      allow delete: if isAdmin();
    }

    function partUnitOk(unit) {
      return unit == 'pcs' || unit == 'mtr';
    }
    function frequencyOk(value) {
      return value == null || value == 'common' || value == 'occasional';
    }
    function validPart(data) {
      return data.code is string
        && data.code.size() > 0
        && data.code.size() < 120
        && data.name is string
        && data.group is string
        && partUnitOk(data.unit)
        && data.revivable is bool
        && data.revivedStock is number
        && data.revivedStock >= 0
        && frequencyOk(data.frequency)
        && data.revivableEdited is bool
        && data.frequencyEdited is bool;
    }
    // Production may change revived stock only. Catalog edits (including
    // revivable and frequency) are Admin.
    function stockTouchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['revivedStock', 'updatedAt', 'updatedBy'])
        && request.resource.data.revivedStock is number
        && request.resource.data.revivedStock >= 0;
    }

    // Parts catalog. Sales has no access. Dashboard cannot read part rows;
    // it reads partCounts below.
    match /parts/{partId} {
      allow read: if isAdmin() || isProduction();
      allow create: if isAdmin()
        && validPart(request.resource.data)
        && request.resource.data.code == partId;
      allow update: if (isAdmin()
          && validPart(request.resource.data)
          && request.resource.data.code == partId
          && request.resource.data.code == resource.data.code)
        || ((isAdmin() || isProduction()) && stockTouchOnly());
      allow delete: if isAdmin();
    }

    function movementTypeOk(type) {
      return type == 'NEW_PART_USED'
        || type == 'REVIVED_PART_USED'
        || type == 'SENT_TO_REVIVE'
        || type == 'REVIVED_TO_STOCK'
        || type == 'SCRAPPED';
    }
    function validMovement() {
      return request.resource.data.id == movementId
        && movementTypeOk(request.resource.data.type)
        && request.resource.data.partCode is string
        && request.resource.data.partCode.size() > 0
        && request.resource.data.qty is number
        && request.resource.data.qty != 0
        && request.resource.data.machineNumber is string
        && request.resource.data.cycle is number
        && request.resource.data.user is string
        && request.resource.data.reversal is bool
        && request.resource.data.reversesId is string
        && (request.resource.data.reversal == false || request.resource.data.qty < 0)
        && (request.resource.data.reversal == true || request.resource.data.qty > 0);
    }
    // Revive-queue sends are only for parts flagged revivable. A reversal
    // of an earlier send is allowed even if the flag was edited later.
    function reviveSendOk() {
      return request.resource.data.type != 'SENT_TO_REVIVE'
        || request.resource.data.reversal == true
        || get(/databases/$(database)/documents/parts/$(request.resource.data.partCode)).data.revivable == true;
    }

    // Append-only ledger. Undo adds a reversing row; nothing is updated or deleted.
    match /partMovements/{movementId} {
      allow read: if isAdmin() || isProduction();
      allow create: if (isAdmin() || isProduction()) && validMovement() && reviveSendOk();
      allow update, delete: if false;
    }

    function partIsRevivable(code) {
      return get(/databases/$(database)/documents/parts/$(code)).data.revivable == true;
    }
    function validQueuedPart() {
      return request.resource.data.id == itemId
        && request.resource.data.status == 'queued'
        && request.resource.data.partCode is string
        && request.resource.data.qty is number
        && request.resource.data.qty > 0
        && request.resource.data.machineNumber is string
        && request.resource.data.cycle is number
        && partIsRevivable(request.resource.data.partCode);
    }

    match /reviveQueue/{itemId} {
      allow read: if isAdmin() || isProduction();
      allow create: if (isAdmin() || isProduction()) && validQueuedPart();
      allow update: if (isAdmin() || isProduction())
        && request.resource.data.partCode == resource.data.partCode
        && request.resource.data.qty == resource.data.qty
        && request.resource.data.id == resource.data.id
        && (request.resource.data.status == 'queued'
            || request.resource.data.status == 'revived'
            || request.resource.data.status == 'failed'
            || request.resource.data.status == 'reversed');
      allow delete: if false;
    }

    // Aggregate the revive queue can show without opening part rows.
    match /partCounts/{docId} {
      allow read: if isAdmin() || isProduction() || isDashboard();
      allow create, update: if isAdmin() || isProduction();
      allow delete: if isAdmin();
    }

    // Maintenance tickets are an admin-only feature.
    match /tickets/{ticketId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /inventory/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isProduction();
    }

    // Append-only audit trail: any signed-in user can add an entry (that's
    // how every save gets attributed), but only Admin can read the log, and
    // nobody can edit or delete entries after the fact.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
